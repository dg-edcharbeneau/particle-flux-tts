# Copy this file to `.env` and fill in your Deepgram API key.
# Get one at https://console.deepgram.com
#
# This key lives ONLY on the server. It is used to mint short-lived
# tokens for the browser and is never sent to the client.
DEEPGRAM_API_KEY=

# The text-to-speech voice. Served to the browser via /api/config, so changing
# it only needs a server restart — no code edit.
#
# The name selects the API generation automatically:
#   flux-*  -> /v2/speak  Flux TTS: expressive, native interruption. English only.
#   aura*   -> /v1/speak  Aura-2: use for languages Flux TTS doesn't cover yet.
#
# Flux voices: flux-haley-en, flux-hannah-en, flux-alexis-en, flux-sienna-en,
#              flux-cole-en, flux-miles-en, flux-cliff-en (deep male),
#              flux-kit-en / flux-colin-en / flux-sean-en (British),
#              flux-maeve-en (Irish), flux-sharon-en (Australian),
#              flux-priya-en / flux-naveen-en (Indian), flux-kai-en (Singaporean)
#   https://developers.deepgram.com/docs/flux-tts/voices
# Aura-2 (non-English): aura-2-julius-de, aura-2-agathe-fr, aura-2-celeste-es,
#              aura-2-livia-it, aura-2-fujin-ja, aura-2-rhea-nl
#   https://developers.deepgram.com/docs/tts-models
DEEPGRAM_TTS_VOICE=flux-haley-en

# The speech-to-text model. Flux is built for conversational turn-taking and is
# what drives barge-in here, so a non-Flux model will change that behaviour.
# Full list: https://developers.deepgram.com/docs/models-languages-overview
DEEPGRAM_STT_MODEL=flux-general-en

# Port the local server listens on.
PORT=3031

# Time-to-live (seconds) for the browser tokens minted by /api/token.
# The JWT TTL only needs to cover the WebSocket handshake; once a socket
# is open, token expiry does not close it. Keep this short.
TOKEN_TTL_SECONDS=60
